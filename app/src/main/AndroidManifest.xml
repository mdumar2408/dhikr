<?xml version="1.0" encoding="utf-8"?>
<!--
    The manifest is the app's contract with the Android OS. The system reads it at
    install time (before any code runs) to learn which components exist, which
    permissions are requested and how the app may be launched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal (install-time) permission: only the waveform haptic options use the Vibrator.
         View haptics (the defaults) need no permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DhikrApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dhikr">

        <!--
            An Activity is a single full-screen entry point with its own lifecycle.
            exported="true" lets the launcher (another app) start it; the MAIN/LAUNCHER
            intent filter is what puts an icon in the app drawer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget (Phase 6). Exported: the launcher's AppWidget host must reach it. -->
        <receiver
            android:name=".widget.DhikrWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dhikr_widget_info" />
        </receiver>

        <!-- Per-widget chooser (Follow Flow / pinned dhikr), started by the launcher. -->
        <activity
            android:name=".widget.DhikrWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
